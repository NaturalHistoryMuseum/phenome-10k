if ($should_block) {
    return 403;
}

location /robots.txt {
    root /var/www;
}

location ^~ /.well-known {
    root /var/www/;
}

location / {
    limit_req zone=limit_ip burst=60 nodelay;
    limit_req zone=limit_ua burst=60 nodelay;

    # if the maintenance page exists, return service unavailable
    if (-f /usr/share/nginx/html/maintenance.html) {
        return 503;
    }

    proxy_pass http://phenome10k;
    proxy_connect_timeout 10s;
    proxy_read_timeout 10s;

    # Redefine the header fields that NGINX sends to the upstream server
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;

    # Allow large file uploads
    client_max_body_size {{ max_upload_size_mb }}M;
}

error_page 503 /maintenance.html;
location = /maintenance.html {
    root  /usr/share/nginx/html/;
}
