[Unit]
Description=cloudflared
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=60
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --protocol http2 --token {{ cloudflare_token }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target

